# ---- API ------------------------------------------------------------------
PORT=8787
# Where the API container's port is published on the host. 172.17.0.1 is the
# docker0 gateway on forum-app: reachable from the forum-web nginx container
# (which proxies /skillwall/ here) and from the host, but not from outside.
API_BIND=172.17.0.1
# Comma-separated origins allowed to call the API directly (the standalone site
# later). The walls proxy same-origin and need nothing here.
CORS_ORIGINS=

# Where uploaded images are written (compose mounts a volume here).
UPLOAD_DIR=./data/uploads

# ---- Postgres (docker-compose uses these for the db service too) ----------
POSTGRES_USER=skillwall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skillwall
# Inside compose the API reaches the db service by name:
DATABASE_URL=postgres://skillwall:change-me@db:5432/skillwall
# For running migrate/dev on the host against the published port:
# DATABASE_URL=postgres://skillwall:change-me@127.0.0.1:5433/skillwall

# ---- Wall realms (who may log in) ----------------------------------------
# One entry per Supabase backend. A wall JWT names its realm through `iss`,
# so the client never says which school it is — the API matches the issuer.
# CHECK THE REAL ISSUER: self-hosted GoTrue signs `iss` = GOTRUE_JWT_ISSUER when
# that env is set (both wall stacks set it to the BARE host, no /auth/v1), else
# API_EXTERNAL_URL + "/auth/v1". Read it off the running container:
#   docker exec supabase-auth env | grep -E "GOTRUE_JWT_ISSUER|API_EXTERNAL_URL"
# List every form you might see; a miss is a silent 401 (unknown_issuer).
#   secret  : HS256 JWT_SECRET of a self-hosted stack (forum-storage .env)
#   jwksUrl : for Supabase Cloud projects on asymmetric keys
#   schools : ids a realm may carry in the X-Wall-School header (Go8 shares one project)
REALMS='[
  {"id":"unimelb","issuers":["https://api.talkwalll.com","https://api.unimelbwall.com","https://api.talkwalll.com/auth/v1","https://api.unimelbwall.com/auth/v1"],"secret":"<JWT_SECRET of the unimelb stack>"},
  {"id":"monash","issuers":["https://api.monashwall.com","https://api.monashwall.com/auth/v1"],"secret":"<JWT_SECRET of the monash stack>"},
  {"id":"go8","issuers":["https://sscstwlxfvfcusbhsfmm.supabase.co/auth/v1"],"jwksUrl":"https://sscstwlxfvfcusbhsfmm.supabase.co/auth/v1/.well-known/jwks.json","secret":"<legacy JWT secret, if the project still signs HS256>","schools":["anu","unsw","usyd","uq","uwa","adelaide"]}
]'

# ---- Dev only -------------------------------------------------------------
# `npm run dev:token` mints a wall-shaped JWT with this realm's secret so you can
# call the API locally without a real wall login.
DEV_REALM=unimelb
